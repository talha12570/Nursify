# ============================================================================
# Nursify Healthcare Platform - Smart Backdating Script (PowerShell)
# ============================================================================
# Reads actual file creation dates and commits 3-4 hours later
# Repository: https://github.com/USERNAME/Nursify.git (UPDATE THIS)
# Timezone: Pakistan Standard Time (UTC+5)
# ============================================================================

$ErrorActionPreference = "Stop"

Write-Host "╔════════════════════════════════════════════════════════════════╗" -ForegroundColor Blue
Write-Host "║         Nursify - Smart Backdating with File Dates            ║" -ForegroundColor Blue
Write-Host "║         Commits created 3-4 hours after file creation         ║" -ForegroundColor Blue
Write-Host "║                   Pakistan Time (UTC+5)                        ║" -ForegroundColor Blue
Write-Host "╚════════════════════════════════════════════════════════════════╝" -ForegroundColor Blue
Write-Host ""

# ============================================================================
# CONFIGURATION
# ============================================================================

$DEVELOPER1_NAME = "Talha Aslam"
$DEVELOPER1_EMAIL = "talha.aslam591@gmail.com"

$DEVELOPER2_NAME = "Muhammad Wajahat"
$DEVELOPER2_EMAIL = "47749@students.riphah.edu.pk"

$REPO_URL = "https://github.com/talha12570/Nursify.git"
$REPO_NAME = "Nursify"

$SOURCE_CODE_PATH = Get-Location
$env:TZ = "Asia/Karachi"

Write-Host "Configuration:" -ForegroundColor Yellow
Write-Host "  Developer 1:  $DEVELOPER1_NAME ($DEVELOPER1_EMAIL)"
Write-Host "  Developer 2:  $DEVELOPER2_NAME ($DEVELOPER2_EMAIL)"
Write-Host "  Repository:   $REPO_URL"
Write-Host "  Source Code:  $SOURCE_CODE_PATH"
Write-Host "  Timezone:     Pakistan (UTC+5)"
Write-Host "  Strategy:     Commits 3-4 hours after file creation"
Write-Host ""

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

function Get-FileTimestamp {
    param($FilePath)
    
    if (Test-Path $FilePath) {
        $file = Get-Item $FilePath
        return $file.LastWriteTime
    }
    return $null
}

function Add-RandomHours {
    param($DateTime)
    
    $randomHours = Get-Random -Minimum 3 -Maximum 5
    $randomMinutes = Get-Random -Minimum 0 -Maximum 60
    return $DateTime.AddHours($randomHours).AddMinutes($randomMinutes)
}

function Format-GitDate {
    param($DateTime)
    
    return $DateTime.ToString("yyyy-MM-dd HH:mm:ss")
}

# ============================================================================
# ANALYZE FILES
# ============================================================================

Write-Host "Analyzing file dates..." -ForegroundColor Blue
Write-Host ""

$fileData = @{}
$totalFiles = 0

# Scan all relevant files (exclude .bat and .md except README.md)
$extensions = @("*.js", "*.jsx", "*.ts", "*.tsx", "*.json", "*.css")
foreach ($ext in $extensions) {
    Get-ChildItem -Path . -Include $ext -Recurse -File -ErrorAction SilentlyContinue | 
        Where-Object { $_.FullName -notmatch "node_modules|\.git" } |
        ForEach-Object {
            $fileData[$_.FullName] = $_.LastWriteTime
            $totalFiles++
        }
}

# Add README.md specifically
if (Test-Path "README.md") {
    $fileData["README.md"] = (Get-Item "README.md").LastWriteTime
    $totalFiles++
}

Write-Host "Found $totalFiles files with dates" -ForegroundColor Green
Write-Host ""

# ============================================================================
# SAFETY CHECKS
# ============================================================================

Write-Host "SAFETY CHECKS:" -ForegroundColor Yellow

if (-not (Test-Path "Server") -or -not (Test-Path "App")) {
    Write-Host "ERROR: Server/ or App/ folder not found" -ForegroundColor Red
    Write-Host "Run this script from the Nursify root directory"
    exit 1
}

Write-Host "[OK] Nursify project structure verified" -ForegroundColor Green
Write-Host ""

# ============================================================================
# CONFIRMATIONS
# ============================================================================

Write-Host "WARNING:" -ForegroundColor Red -NoNewline
Write-Host ""
Write-Host "  This will create a FRESH Git history" -ForegroundColor Red
Write-Host "  Repository: $REPO_URL" -ForegroundColor Red
Write-Host "  Commits will be backdated to file creation dates + 3-4 hours" -ForegroundColor Red
Write-Host ""

$configConfirm = Read-Host "Have you updated DEVELOPER names, emails, and REPO_URL? (type YES)"

if ($configConfirm -ne "YES") {
    Write-Host "Please update configuration first" -ForegroundColor Red
    exit 1
}

Write-Host ""
$confirm = Read-Host "Type 'CREATE HISTORY' to proceed"

if ($confirm -ne "CREATE HISTORY") {
    Write-Host "Aborted" -ForegroundColor Red
    exit 1
}

Write-Host "Starting..." -ForegroundColor Green
Write-Host ""

# ============================================================================
# REPOSITORY SETUP
# ============================================================================

Write-Host "Setting up repository..." -ForegroundColor Blue

# Create temporary directory for new repo
$TEMP_DIR = "Nursify-Backdated-$(Get-Date -Format 'yyyyMMdd-HHmmss')"
New-Item -ItemType Directory -Path $TEMP_DIR | Out-Null
Set-Location $TEMP_DIR

git init
git branch -M main

Write-Host "[OK] Fresh repository initialized" -ForegroundColor Green
Write-Host ""

# ============================================================================
# SMART COMMIT FUNCTION
# ============================================================================

function New-SmartCommit {
    param(
        [string]$Author,
        [string]$Email,
        [string]$Message,
        [DateTime]$Timestamp,
        [string[]]$Files
    )
    
    # Add random 3-4 hours
    $commitTime = Add-RandomHours -DateTime $Timestamp
    $gitDate = Format-GitDate -DateTime $commitTime
    
    $env:GIT_AUTHOR_NAME = $Author
    $env:GIT_AUTHOR_EMAIL = $Email
    $env:GIT_COMMITTER_NAME = $Author
    $env:GIT_COMMITTER_EMAIL = $Email
    $env:GIT_AUTHOR_DATE = "$gitDate +0500"
    $env:GIT_COMMITTER_DATE = "$gitDate +0500"
    
    # Copy files
    foreach ($file in $Files) {
        $sourcePath = Join-Path $SOURCE_CODE_PATH $file
        if (Test-Path $sourcePath) {
            $destDir = Split-Path $file -Parent
            if ($destDir -and $destDir -ne ".") {
                New-Item -ItemType Directory -Path $destDir -Force -ErrorAction SilentlyContinue | Out-Null
            }
            Copy-Item -Path $sourcePath -Destination $file -Recurse -Force -ErrorAction SilentlyContinue
        }
    }
    
    git add -A
    
    $hasDiff = git diff --cached --quiet
    if ($LASTEXITCODE -ne 0) {
        git commit -m $Message --quiet
        Write-Host "[OK] " -NoNewline -ForegroundColor Green
        Write-Host "$gitDate " -NoNewline -ForegroundColor Cyan
        Write-Host "- " -NoNewline
        Write-Host "$($Author): " -NoNewline -ForegroundColor White
        Write-Host $Message
    }
}

# ============================================================================
# CREATE COMMITS BASED ON FILE DATES
# ============================================================================

Write-Host "Creating commits based on file creation dates..." -ForegroundColor Blue
Write-Host ""

# Get earliest timestamp
$earliestTime = ($fileData.Values | Sort-Object | Select-Object -First 1)
